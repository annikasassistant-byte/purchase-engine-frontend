# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored - never commit real credentials.
#
# Both variables are read server-side only (src/lib/env.ts) - neither is
# prefixed NEXT_PUBLIC_, so neither ever reaches the browser bundle. See
# docs/adr/0001-server-side-proxy-for-the-backend-api.md.

# The deployed backend (see ../purchase_engine - the FastAPI app on Render).
PURCHASE_ENGINE_API_URL="https://buyback-purchase-engine-api.onrender.com"

# Must match the backend's API_KEY exactly - get it from purchase_engine/.env
# (or Render's dashboard -> Environment, once that's the source of truth).
PURCHASE_ENGINE_API_KEY=""
